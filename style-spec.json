{
  "version": 2,
  "viewBox": "0 0 24 24",
  "livePadding": 2,
  "stroke": 1.5,
  "linecap": "round",
  "linejoin": "round",
  "color": "currentColor",
  "fill": "none",
  "cornerRadius": 2,
  "snap": 0.5,
  "minGap": 1.25,
  "minDetail": 1.5,
  "maxPaths": 8,
  "maxBytes": 2048,
  "displaySizes": [
    16,
    20,
    24
  ],
  "variants": [
    "outline"
  ],
  "smallSizeGuidance": {
    "displaySizes": [
      16,
      20,
      24
    ],
    "minimumVisibleGap": 1.25,
    "minimumFeatureSize": 1.5,
    "rule": "Keep distinctive silhouettes and avoid micro-details that disappear at 16px. Review every icon at 16px before release."
  }
}
