{
  "name": "@odiaui/icons-react",
  "version": "0.3.0",
  "description": "Free, open-source Odisha icons as typed React components.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "generate": "node scripts/build.mjs",
    "build": "node scripts/build.mjs && tsup src/index.ts --format esm,cjs --dts --clean --sourcemap --external react --external react/jsx-runtime",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.6.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rudranboitei/odia-icons.git",
    "directory": "packages/react"
  },
  "homepage": "https://icons.odiaui.xyz",
  "bugs": {
    "url": "https://github.com/rudranboitei/odia-icons/issues"
  },
  "keywords": [
    "icons",
    "react",
    "svg",
    "odisha",
    "odia",
    "icon-set",
    "typescript",
    "tree-shaking"
  ],
  "engines": {
    "node": ">=18"
  }
}
